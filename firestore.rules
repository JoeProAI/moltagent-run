rules_version = '2';

// MoltAgent.run — per-session access control.
// Every visitor is signed in with Firebase Anonymous Auth, which gives them a
// stable uid. All swarm state is owner-scoped: you can only read and write
// your own documents. Nothing is world-writable.
//
// Deploy: firebase deploy --only firestore:rules
// Also required: Firebase console -> Authentication -> Sign-in method ->
//                enable "Anonymous".
service cloud.firestore {
  match /databases/{database}/documents {

    // Live swarm agent nodes — one document per node, tagged with owner uid.
    match /activeAgents/{docId} {
      allow read: if request.auth != null
                  && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.owner == request.auth.uid;
    }

    // Per-user system state (Daytona credits, NOESIS sync flag).
    match /userState/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid;
    }

    // Everything else is denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
